<UserControl x:Class="BFR.App.Controls.TemMascot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="100" Height="104" IsTabStop="False" Focusable="False" SnapsToDevicePixels="False">
    <!--
        Tem, linh vật của BFR: một chiếc thẻ nhãn có lỗ xỏ dây (đúng thứ app gắn lên tệp).
        Vẽ hoàn toàn bằng vector trong hệ toạ độ 100 x 104 nên co giãn theo Width/Height mà không vỡ nét.
        Thân tô gradient theo bảng màu nhấn đang chọn (Glow1 → Glow2). Biểu cảm đổi bằng thuộc tính State.
        Chuyển động (chớp mắt, nhấp nhô, thanh tiến trình, pháo giấy) do code-behind chạy và tắt khi giảm chuyển động.
    -->
    <UserControl.Resources>
        <LinearGradientBrush x:Key="TemBody" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{DynamicResource BfrGlow1Color}" Offset="0" />
            <GradientStop Color="{DynamicResource BfrGlow2Color}" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="TemInk" Color="#FF15161D" />
        <SolidColorBrush x:Key="TemCheek" Color="#FFFF8FB3" Opacity="0.55" />
        <Style x:Key="TemStroke" TargetType="Path">
            <Setter Property="Stroke" Value="{StaticResource TemInk}" />
            <Setter Property="StrokeThickness" Value="3.2" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <Canvas Width="100" Height="104" ClipToBounds="False">
            <Canvas.RenderTransform>
                <TranslateTransform x:Name="Bob" Y="0" />
            </Canvas.RenderTransform>

            <!-- Dây xỏ -->
            <Path Data="M50,6 C43,6 38,11 38,17" Stroke="{DynamicResource BfrFg2}" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.55" />

            <!-- Thân thẻ và lỗ xỏ dây -->
            <Path Fill="{StaticResource TemBody}"
                  Data="M28,18 L72,18 A16,16 0 0 1 88,34 L88,72 A16,16 0 0 1 72,88 L28,88 A16,16 0 0 1 12,72 L12,34 A16,16 0 0 1 28,18 Z" />
            <Ellipse Canvas.Left="44.5" Canvas.Top="21.5" Width="11" Height="11" Fill="{DynamicResource BfrSurface1}" Opacity="0.9" />

            <!-- Má hồng -->
            <Ellipse Canvas.Left="22.5" Canvas.Top="64.6" Width="11" Height="6.8" Fill="{StaticResource TemCheek}" />
            <Ellipse Canvas.Left="66.5" Canvas.Top="64.6" Width="11" Height="6.8" Fill="{StaticResource TemCheek}" />

            <!-- Mắt mở (nghỉ, ái ngại): nhóm này chớp mắt -->
            <Canvas x:Name="EyesOpen">
                <Canvas.RenderTransform>
                    <ScaleTransform x:Name="Blink" ScaleX="1" ScaleY="1" CenterX="50" CenterY="58" />
                </Canvas.RenderTransform>
                <Ellipse Canvas.Left="32.8" Canvas.Top="51.6" Width="10.4" Height="12.8" Fill="{StaticResource TemInk}" />
                <Ellipse Canvas.Left="56.8" Canvas.Top="51.6" Width="10.4" Height="12.8" Fill="{StaticResource TemInk}" />
                <Ellipse Canvas.Left="38.1" Canvas.Top="54.1" Width="3.4" Height="3.4" Fill="White" />
                <Ellipse Canvas.Left="62.1" Canvas.Top="54.1" Width="3.4" Height="3.4" Fill="White" />
            </Canvas>
            <!-- Mắt cong vui -->
            <Canvas x:Name="EyesHappy" Visibility="Collapsed">
                <Path Style="{StaticResource TemStroke}" StrokeThickness="3.4" Data="M31,59 Q38,50 45,59" />
                <Path Style="{StaticResource TemStroke}" StrokeThickness="3.4" Data="M55,59 Q62,50 69,59" />
            </Canvas>
            <!-- Mắt nhắm khi ngủ -->
            <Canvas x:Name="EyesSleep" Visibility="Collapsed">
                <Path Style="{StaticResource TemStroke}" Data="M31,60 Q38,66 45,60" />
                <Path Style="{StaticResource TemStroke}" Data="M55,60 Q62,66 69,60" />
            </Canvas>
            <!-- Mắt liếc sang phải khi đang làm -->
            <Canvas x:Name="EyesWork" Visibility="Collapsed">
                <Ellipse Canvas.Left="34.8" Canvas.Top="51.6" Width="10.4" Height="12.8" Fill="{StaticResource TemInk}" />
                <Ellipse Canvas.Left="58.8" Canvas.Top="51.6" Width="10.4" Height="12.8" Fill="{StaticResource TemInk}" />
                <Ellipse Canvas.Left="40.3" Canvas.Top="54.3" Width="3.4" Height="3.4" Fill="White" />
                <Ellipse Canvas.Left="64.3" Canvas.Top="54.3" Width="3.4" Height="3.4" Fill="White" />
            </Canvas>

            <!-- Lông mày xệ khi ái ngại -->
            <Path x:Name="Brows" Visibility="Collapsed" Style="{StaticResource TemStroke}" StrokeThickness="3" Data="M30,48 L42,44 M70,48 L58,44" />

            <!-- Miệng -->
            <Path x:Name="MouthSmile" Style="{StaticResource TemStroke}" Data="M43,71 Q50,78 57,71" />
            <Path x:Name="MouthBig" Visibility="Collapsed" Fill="{StaticResource TemInk}" Data="M40,70 Q50,81 60,70 Z" />
            <Path x:Name="MouthFrown" Visibility="Collapsed" Style="{StaticResource TemStroke}" Data="M41,75 Q50,68 59,75" />
            <Ellipse x:Name="MouthO" Visibility="Collapsed" Canvas.Left="46.6" Canvas.Top="70.4" Width="6.8" Height="5.2" Fill="{StaticResource TemInk}" />
            <Rectangle x:Name="MouthFlat" Visibility="Collapsed" Canvas.Left="43" Canvas.Top="71" Width="14" Height="4" RadiusX="2" RadiusY="2" Fill="{StaticResource TemInk}" />

            <!-- Giọt mồ hôi (ái ngại) -->
            <Path x:Name="Sweat" Visibility="Collapsed" Fill="#FF9BD4FF" Data="M80,44 Q84,50 80,54 Q76,50 80,44 Z" />

            <!-- Chữ z khi ngủ -->
            <Canvas x:Name="Zzz" Visibility="Collapsed">
                <TextBlock Canvas.Left="74" Canvas.Top="14" Text="z" FontFamily="{DynamicResource BfrFontDisplay}" FontSize="13" Foreground="{DynamicResource BfrFg2}" />
                <TextBlock Canvas.Left="85" Canvas.Top="3" Text="z" FontFamily="{DynamicResource BfrFontDisplay}" FontSize="10" Foreground="{DynamicResource BfrFg2}" />
            </Canvas>

            <!-- Thanh tiến trình khi đang làm -->
            <Canvas x:Name="Progress" Visibility="Collapsed">
                <Rectangle Canvas.Left="22" Canvas.Top="94" Width="56" Height="5" RadiusX="2.5" RadiusY="2.5" Fill="{DynamicResource BfrLine}" />
                <Rectangle x:Name="ProgressFill" Canvas.Left="22" Canvas.Top="94" Width="30" Height="5" RadiusX="2.5" RadiusY="2.5" Fill="{DynamicResource BfrAccFg}" />
            </Canvas>

            <!-- Pháo giấy khi vui -->
            <Canvas x:Name="Confetti" Visibility="Collapsed">
                <Rectangle Canvas.Left="14" Canvas.Top="14" Width="5" Height="9" RadiusX="1.5" RadiusY="1.5" Fill="#FFFFB74D"><Rectangle.RenderTransform><TranslateTransform /></Rectangle.RenderTransform></Rectangle>
                <Rectangle Canvas.Left="82" Canvas.Top="10" Width="5" Height="9" RadiusX="1.5" RadiusY="1.5" Fill="#FF3DDC97"><Rectangle.RenderTransform><TranslateTransform /></Rectangle.RenderTransform></Rectangle>
                <Rectangle Canvas.Left="26" Canvas.Top="4" Width="5" Height="9" RadiusX="1.5" RadiusY="1.5" Fill="#FFFFFFFF"><Rectangle.RenderTransform><TranslateTransform /></Rectangle.RenderTransform></Rectangle>
                <Rectangle Canvas.Left="70" Canvas.Top="2" Width="5" Height="9" RadiusX="1.5" RadiusY="1.5" Fill="#FFFF6B6B"><Rectangle.RenderTransform><TranslateTransform /></Rectangle.RenderTransform></Rectangle>
            </Canvas>
        </Canvas>
    </Viewbox>
</UserControl>
