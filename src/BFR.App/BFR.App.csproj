<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Cần WinRT cho Microsoft Store IAP (Windows.Services.Store). -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BFR.App</RootNamespace>
    <AssemblyName>BatchFileRenamer</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BFR.Core\BFR.Core.csproj" />
    <ProjectReference Include="..\BFR.Presentation\BFR.Presentation.csproj" />
    <ProjectReference Include="..\BFR.Store\BFR.Store.csproj" />
    <ProjectReference Include="..\BFR.Media\BFR.Media.csproj" />
  </ItemGroup>

  <!-- Theme dùng chung phải nạp được bằng URI tương đối (ThemeManager hoán đổi
       sáng/tối lúc chạy) nên đóng gói dạng Resource (file .xaml rời), không phải Page. -->
  <ItemGroup>
    <Page Remove="Themes\*.xaml" />
    <Resource Include="Themes\*.xaml" />
    <Page Remove="Themes\Bfr\*.xaml" />
    <Resource Include="Themes\Bfr\*.xaml" />
  </ItemGroup>

  <!-- Phông nhúng (giấy phép OFL, xem Resources/Fonts/OFL-*.txt): Inter cho thân chữ, Plus Jakarta Sans cho tiêu đề. -->
  <ItemGroup>
    <Resource Include="Resources\Fonts\*.ttf" />
    <None Include="Resources\Fonts\OFL-*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>
