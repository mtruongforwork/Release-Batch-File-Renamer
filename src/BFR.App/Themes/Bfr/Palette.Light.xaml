<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Bảng màu sáng: không chỉ đảo ngược bảng tối, từng màu được chọn lại để giữ tương phản. -->

    <Color x:Key="BfrBgBaseColor">#FFF4F4F9</Color>
    <Color x:Key="BfrSurface1Color">#FFFFFFFF</Color>
    <Color x:Key="BfrSurface2Color">#FFEFEFF6</Color>
    <Color x:Key="BfrGlassColor">#B8FFFFFF</Color>
    <Color x:Key="BfrLineColor">#17141428</Color>
    <Color x:Key="BfrFgColor">#FF15161D</Color>
    <Color x:Key="BfrFg2Color">#FF53566A</Color>
    <Color x:Key="BfrFg3Color">#FF72758A</Color>
    <Color x:Key="BfrOkColor">#FF0A7A50</Color>
    <Color x:Key="BfrWarnColor">#FFA15C00</Color>
    <Color x:Key="BfrBadColor">#FFC2303A</Color>
    <Color x:Key="BfrOkSoftColor">#1A0A7A50</Color>
    <Color x:Key="BfrWarnSoftColor">#1AA15C00</Color>
    <Color x:Key="BfrBadSoftColor">#1AC2303A</Color>
    <Color x:Key="BfrShadowColor">#FF28284F</Color>
    <Color x:Key="BfrOnAccentColor">#FFFFFFFF</Color>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="BfrShadowOpacity">0.16</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="BfrGlowOpacity">0.12</sys:Double>

    <SolidColorBrush x:Key="BfrBgBase" Color="{DynamicResource BfrBgBaseColor}" />
    <SolidColorBrush x:Key="BfrSurface1" Color="{DynamicResource BfrSurface1Color}" />
    <SolidColorBrush x:Key="BfrSurface2" Color="{DynamicResource BfrSurface2Color}" />
    <SolidColorBrush x:Key="BfrGlass" Color="{DynamicResource BfrGlassColor}" />
    <SolidColorBrush x:Key="BfrLine" Color="{DynamicResource BfrLineColor}" />
    <SolidColorBrush x:Key="BfrFg" Color="{DynamicResource BfrFgColor}" />
    <SolidColorBrush x:Key="BfrFg2" Color="{DynamicResource BfrFg2Color}" />
    <SolidColorBrush x:Key="BfrFg3" Color="{DynamicResource BfrFg3Color}" />
    <SolidColorBrush x:Key="BfrOk" Color="{DynamicResource BfrOkColor}" />
    <SolidColorBrush x:Key="BfrWarn" Color="{DynamicResource BfrWarnColor}" />
    <SolidColorBrush x:Key="BfrBad" Color="{DynamicResource BfrBadColor}" />
    <SolidColorBrush x:Key="BfrOkSoft" Color="{DynamicResource BfrOkSoftColor}" />
    <SolidColorBrush x:Key="BfrWarnSoft" Color="{DynamicResource BfrWarnSoftColor}" />
    <SolidColorBrush x:Key="BfrBadSoft" Color="{DynamicResource BfrBadSoftColor}" />
    <SolidColorBrush x:Key="BfrOnAccent" Color="{DynamicResource BfrOnAccentColor}" />

    <SolidColorBrush x:Key="BfrAccFg" Color="{DynamicResource BfrAccFgLightColor}" />
</ResourceDictionary>
